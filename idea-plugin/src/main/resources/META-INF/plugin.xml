<idea-plugin>
    <id>github.com.gengyoubo.mfcl.idea</id>
    <name>MFCL Legacy Navigation</name>
    <vendor>MFCL</vendor>
    <description>Completion and navigation for MFCL legacy accessors and Mixin injection targets.</description>
    <version>${version}</version>
    <idea-version since-build="253" until-build="261.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="JAVA" implementation="github.com.gengyoubo.mfcl.idea.LegacyReferenceContributor"/>
        <completion.contributor language="JAVA" implementationClass="github.com.gengyoubo.mfcl.idea.LegacyCompletionContributor"/>
        <annotator language="JAVA" implementationClass="github.com.gengyoubo.mfcl.idea.LegacyAnnotator"/>
        <codeInsight.unresolvedReferenceQuickFixProvider implementation="github.com.gengyoubo.mfcl.idea.LegacyJarQuickFixProvider"/>
        <postStartupActivity implementation="github.com.gengyoubo.mfcl.idea.LegacyNamesAutoAttach"/>
        <referenceImporter implementation="github.com.gengyoubo.mfcl.idea.LegacyTypeAutoImport"/>
        <gotoDeclarationHandler implementation="github.com.gengyoubo.mfcl.idea.LegacyTypeGotoDeclaration" order="first"/>
    </extensions>
</idea-plugin>
