<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="Probe" target="SYSTEM_ERR"><PatternLayout pattern="[%level] %logger: %msg%n"/></Console>
    </Appenders>
    <Loggers><Root level="warn"><AppenderRef ref="Probe"/></Root></Loggers>
</Configuration>
